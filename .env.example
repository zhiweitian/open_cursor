DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
PORT=3847

# Web/CLI 无 Key 调试（见 QA-NOTES.md）
# OPENCURSOR_MOCK_LLM=fast
# OPENCURSOR_WORKSPACE=
# 网页搜索端点，会附上 ?q=
# OPENCURSOR_SEARCH_URL=http://127.0.0.1:8080/search
# 补全通道，和聊天模型分开。POST {prefix,suffix,model}，返回 {completion}
# OPENCURSOR_COMPLETE_URL=http://127.0.0.1:8081/complete
# OPENCURSOR_COMPLETE_MODEL=complete
# 嵌入：hash 为本地词袋。bge 为本机 Xenova/bge-small-en-v1.5，首次下载到 data/models，代码不离开本机
# OPENCURSOR_EMBED_MODEL=bge
